@model RaceDay.Mvc.Models.ViewModels.CategoryViewModel

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3"></div>

<input asp-for="CategoryId" type="hidden" />
<input asp-for="EventId" type="hidden" />

<div class="mb-3">
    <label asp-for="CategoryName" class="form-label"></label>
    <input asp-for="CategoryName" class="form-control"
           placeholder="e.g. Under 18 Boys" />
    <span asp-validation-for="CategoryName"
          class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description"
              class="form-control"
              rows="3"
              placeholder="Category description"></textarea>
    <span asp-validation-for="Description"
          class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryType" class="form-label"></label>

    <select asp-for="CategoryType" class="form-select">
        <option value="">-- Select Category Type --</option>
        <option value="Age">Age</option>
        <option value="Distance">Distance</option>
    </select>

    <span asp-validation-for="CategoryType"
          class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="AgeGroup" class="form-label"></label>
    <input asp-for="AgeGroup"
           class="form-control"
           placeholder="e.g. Under 18" />
    <span asp-validation-for="AgeGroup"
          class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DistanceKm" class="form-label"></label>
    <input asp-for="DistanceKm"
           class="form-control"
           type="number"
           step="0.01"
           placeholder="e.g. 5.00" />
    <span asp-validation-for="DistanceKm"
          class="text-danger"></span>
</div>
