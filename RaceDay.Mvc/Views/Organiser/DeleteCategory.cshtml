@using RaceDay.Contracts
@model CategoryDto

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h3>Delete Category</h3>
        </div>

        <div class="card-body">
            <p>Are you sure you want to delete this category?</p>

            <dl class="row">
                <dt class="col-sm-3">Category Name</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>

                <dt class="col-sm-3">Category Type</dt>
                <dd class="col-sm-9">@Model.CategoryType</dd>

                <dt class="col-sm-3">Age Group</dt>
                <dd class="col-sm-9">@Model.AgeGroup</dd>

                <dt class="col-sm-3">Distance</dt>
                <dd class="col-sm-9">@Model.DistanceKm km</dd>
            </dl>

            <form asp-action="DeleteCategoryConfirmed" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.CategoryId" />
                <input type="hidden" name="eventId" value="@Model.EventId" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Categories"
                   asp-route-eventId="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
