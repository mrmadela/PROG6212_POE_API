@model RaceDay.Mvc.Models.ViewModels.ResultViewModel

@{
    ViewData["Title"] = "Create Result";
}

<!-- START OF CREATE RESULT PAGE -->
<div class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h3>Record Event Result</h3>
        </div>

        <div class="card-body">

            <p class="text-muted">
                Event #@Model.EventId |
                Enrolment #@Model.EnrolId
            </p>

            <!-- START OF ERROR MESSAGE -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            <!-- END OF ERROR MESSAGE -->

            <form asp-action="CreateResult" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="EventId" type="hidden" />
                <input asp-for="EnrolId" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Duration"
                           class="form-label"></label>

                    <input asp-for="Duration"
                           type="text"
                           class="form-control"
                           placeholder="e.g. 01:25:30" />

                    <span asp-validation-for="Duration"
                          class="text-danger"></span>

                    <small class="text-muted">
                        Format: HH:mm:ss
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="AverageSpeed"
                           class="form-label"></label>

                    <input asp-for="AverageSpeed"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="e.g. 10.50" />

                    <span asp-validation-for="AverageSpeed"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position"
                           class="form-label"></label>

                    <input asp-for="Position"
                           type="number"
                           class="form-control"
                           placeholder="e.g. 1" />

                    <span asp-validation-for="Position"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Record Result
                </button>

                <a asp-action="Results"
                   asp-route-eventId="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
<!-- END OF CREATE RESULT PAGE -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}