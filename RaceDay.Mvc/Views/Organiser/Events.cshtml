@model List<RaceDay.Contracts.EventDto>

@{
    ViewData["Title"] = "Manage Events";
}

<!-- start of organiser events page -->
<section class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

        <div>
            <h1 class="fw-bold">Manage Events</h1>
            <p class="text-muted">
                View and manage the events you have created.
            </p>
        </div>



        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }



        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-dark">
            <i class="bi bi-plus-circle me-2"></i>
            Create New Event
        </a>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <h4>No Events Found</h4>

                <p class="text-muted">
                    You have not created any events yet.
                </p>

                <a asp-controller="Organiser"
                   asp-action="CreateEvent"
                   class="btn btn-dark">
                    Create Your First Event
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.EventName
                                    </td>

                                    <td>
                                        @item.Date.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @item.Location
                                    </td>

                                    <td>
                                        @item.DistanceKm km
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @item.EventType
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-controller="Organiser"
                                               asp-action="EditEvent"
                                               asp-route-id="@item.EventId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-controller="Organiser"
                                               asp-action="DeleteEvent"
                                               asp-route-id="@item.EventId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                            <!-- Categories Navigation -->
                                            <a asp-controller="Organiser"
                                               asp-action="Categories"
                                               asp-route-eventId="@item.EventId"
                                               class="btn btn-sm btn-info">
                                                Categories
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</section>
<!-- end of organiser events page -->

