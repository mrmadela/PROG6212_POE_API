@model RaceDay.Mvc.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Join RaceDay
                    </h2>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger"></div>

                    <form asp-action="Register" method="post">

                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label"></label>

                            <input asp-for="FullName"
                                   class="form-control" />

                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label"></label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label"></label>

                            <input asp-for="Password"
                                   class="form-control"
                                   type="password" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   type="password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role"
                                   class="form-label"></label>

                            <select asp-for="Role"
                                    class="form-select">
                                <option value="Participant">
                                    Participant
                                </option>

                                <option value="Organiser">
                                    Organiser
                                </option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNum"
                                   class="form-label"></label>

                            <input asp-for="PhoneNum"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNum"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdNum"
                                   class="form-label">
                                South African ID Number
                            </label>

                            <input asp-for="IdNum"
                                   class="form-control" />

                            <span asp-validation-for="IdNum"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address"
                                   class="form-label"></label>

                            <textarea asp-for="Address"
                                      class="form-control"></textarea>

                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Create Account
                        </button>
                    </form>

                    <p class="text-center mt-3">
                        Already registered?
                        <a asp-action="Login">
                            Login
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
