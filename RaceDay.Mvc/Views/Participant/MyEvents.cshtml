@model List<RaceDay.Mvc.Models.ViewModels.ParticipantEnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<!-- START OF MY EVENTS PAGE -->
<section class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">My Events</h1>
        <p class="text-muted">
            View the events you have enrolled in.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @item.Event.EventName
                            </h5>

                            <p class="text-muted mb-2">
                                <i class="bi bi-geo-alt me-2"></i>
                                @item.Event.Location
                            </p>

                            <p class="mb-2">
                                <strong>Event Date:</strong>
                                @item.Event.Date.ToString("dd MMM yyyy")
                            </p>

                            <p class="mb-2">
                                <strong>Category:</strong>
                                @item.Category.CategoryName
                            </p>

                            <p class="mb-2">
                                <strong>Enrolment Date:</strong>
                                @item.Enrolment.EnrolDate.ToString("dd MMM yyyy")
                            </p>

                            <span class="badge bg-success">
                                Enrolled
                            </span>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</section>
<!-- END OF MY EVENTS PAGE -->