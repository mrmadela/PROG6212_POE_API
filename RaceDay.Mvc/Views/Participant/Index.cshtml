@model List<RaceDay.Contracts.EventDto>

@{
    ViewData["Title"] = "Upcoming Events";

    // START OF EVENT TYPE FILTER OPTIONS
    var eventTypes = Model
        .Where(item => !string.IsNullOrWhiteSpace(item.EventType))
        .Select(item => item.EventType)
        .Distinct()
        .OrderBy(item => item)
        .ToList();
    // END OF EVENT TYPE FILTER OPTIONS
}

<!-- START OF PARTICIPANT EVENTS PAGE -->
<section class="container py-5">

    <!-- START OF PAGE HEADER -->
    <div class="mb-4">
        <h1 class="fw-bold">Upcoming Events</h1>

        <p class="text-muted">
            Browse and find events you would like to participate in.
        </p>
    </div>
    <!-- END OF PAGE HEADER -->
    <!-- START OF EVENT FILTER FORM -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="Participant"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- START OF SEARCH FIELD -->
                    <div class="col-md-6">

                        <label for="searchTerm"
                               class="form-label fw-semibold">
                            Search Events
                        </label>

                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               value="@ViewBag.SearchTerm"
                               class="form-control"
                               placeholder="Search by event name or location" />

                    </div>
                    <!-- END OF SEARCH FIELD -->
                    <!-- START OF EVENT TYPE FILTER -->
                    <div class="col-md-4">

                        <label for="eventType"
                               class="form-label fw-semibold">
                            Event Type
                        </label>

                        <select id="eventType"
                                name="eventType"
                                class="form-select">

                            <option value="">
                                All Event Types
                            </option>

                            @foreach (var type in eventTypes)
                            {
                                <option value="@type"
                                        selected="@(ViewBag.EventType == type)">
                                    @type
                                </option>
                            }

                        </select>

                    </div>
                    <!-- END OF EVENT TYPE FILTER -->
                    <!-- START OF SEARCH BUTTON -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-dark w-100">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

                    </div>
                    <!-- END OF SEARCH BUTTON -->

                </div>

            </form>

        </div>

    </div>
    <!-- END OF EVENT FILTER FORM -->
    <!-- START OF EVENT COUNT -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="fw-semibold">
            Available Events
        </h5>

        <span class="badge bg-primary">
            @Model.Count Events
        </span>

    </div>
    <!-- END OF EVENT COUNT -->
    <!-- START OF EVENT LIST -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <i class="bi bi-calendar-x display-4 text-muted"></i>

                <h4 class="mt-3">
                    No Events Found
                </h4>

                <p class="text-muted">
                    There are no upcoming events matching your search.
                </p>

                <a asp-controller="Participant"
                   asp-action="Index"
                   class="btn btn-outline-dark">
                    Clear Filters
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <!-- START OF EVENT CARD -->
                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <div class="d-flex justify-content-between
                                                align-items-start mb-3">

                                <span class="badge bg-primary">
                                    @item.EventType
                                </span>

                                <i class="bi bi-calendar-event
                                                  text-muted fs-4"></i>

                            </div>

                            <h5 class="card-title fw-bold">
                                @item.EventName
                            </h5>

                            <p class="text-muted mb-3">
                                <i class="bi bi-geo-alt me-2"></i>
                                @item.Location
                            </p>

                            <hr />

                            <div class="d-flex justify-content-between
                                                align-items-center mb-2">

                                <span class="text-muted">
                                    <i class="bi bi-calendar3 me-2"></i>
                                    Event Date
                                </span>

                                <span class="fw-semibold">
                                    @item.Date.ToString("dd MMM yyyy")
                                </span>

                            </div>

                            <div class="d-flex justify-content-between
                                                align-items-center">

                                <span class="text-muted">
                                    <i class="bi bi-signpost-2 me-2"></i>
                                    Distance
                                </span>

                                <span class="fw-semibold">
                                    @item.DistanceKm km
                                </span>

                            </div>

                            <div class="card-footer bg-white border-0">

                                <a asp-controller="Participant"
                                   asp-action="Details"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-outline-primary w-100">

                                    <i class="bi bi-eye me-2"></i>
                                    View Details

                                </a>

                            </div>

                        </div>

                    </div>
                    <!-- END OF EVENT CARD -->

                </div>
            }

        </div>
    }
    <!-- END OF EVENT LIST -->

</section>
<!-- END OF PARTICIPANT EVENTS PAGE -->
