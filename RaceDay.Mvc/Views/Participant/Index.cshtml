@{
    ViewData["Title"] = "Participant Dashboard";
}

<!-- start of participant dashboard -->
<section class="container py-5">

    <div class="mb-4">
        <h1 class="display-5 fw-bold">Participant Dashboard</h1>
        <p class="text-muted">
            Discover upcoming races, manage your enrolments and view your results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Events</h5>
                    <p class="card-text">
                        Browse upcoming RaceDay events and find your next race.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Events"
                       class="btn btn-dark">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Events</h5>
                    <p class="card-text">
                        View your enrolled events and enrolment statuses.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-dark">
                        My Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Results</h5>
                    <p class="card-text">
                        Check your race results and finishing positions.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-dark">
                        View Results
                    </a>
                </div>
            </div>
        </div>

    </div>

</section>
<!-- end of participant dashboard -->
